# Copiar a .env para sobrescribir los valores por defecto de docker-compose.yml
# (sin .env, `docker compose up` funciona con los defaults de desarrollo).
#
# Para un despliegue hardened (producción): pon NODE_ENV=production y genera
# secretos propios. La API se niega a arrancar en producción si JWT_SECRET o
# APP_DB_PASSWORD conservan el valor por defecto (hallazgo H-1).
#   openssl rand -base64 48
NODE_ENV=development

# --- SQL Server ---
MSSQL_SA_PASSWORD=Str0ng!Passw0rd2024
MSSQL_PID=Developer
DB_NAME=TasksDb
APP_DB_USER=tasks_app
APP_DB_PASSWORD=TasksApp#2024Secure
SEED_DATA=1

# --- Backend ---
JWT_SECRET=change-me-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=1h
AUTH_USERNAME=admin
AUTH_PASSWORD=admin123
CORS_ORIGIN=http://localhost:8080

# --- Puertos publicados en el host ---
SQLSERVER_PORT=1433
BACKEND_PORT=3000
FRONTEND_PORT=8080
